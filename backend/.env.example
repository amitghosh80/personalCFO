# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

DATABASE_URL=sqlite:///./personalcfo.db
MAX_UPLOAD_SIZE_MB=10

# Required for the conversational chat feature. Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Signs login session tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-jwt-secret-here

# Comma-separated list of extra allowed frontend origins for CORS (e.g. your prod domain).
ALLOWED_ORIGINS=

# Required to email forgot-password reset links. Get a key from https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=PersonalCFO <onboarding@resend.dev>

# Base URL used to build password-reset links (prod: https://personalcfo.agency).
FRONTEND_URL=http://localhost:3000
