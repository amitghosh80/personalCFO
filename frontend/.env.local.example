# Base URL of the backend API. Falls back to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# OAuth client ID from https://console.cloud.google.com/apis/credentials (Web
# application). Must match GOOGLE_CLIENT_ID on the backend. Leave unset to
# hide the "Sign in with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
